<Window
    x:Class="Padmon.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="padmon">

    <Grid x:Name="RootGrid" Background="{ThemeResource PadmonWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Title bar height: lower = logo row shorter and everything below moves up. -->
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="16,0,0,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="0,10,0,0"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Top">
                <Viewbox Width="28" Height="28" Stretch="Uniform">
                    <Path Data="M3.5857,10.0000 L4.9997,8.7970 L4.9997,11.2030 L3.5857,10.0000 Z M14.9997,8.7970 L16.4147,10.0000 L14.9997,11.2030 L14.9997,8.7970 Z M8.7967,15.0000 L11.2027,15.0000 L9.9997,16.4140 L8.7967,15.0000 Z M9.9997,3.5860 L11.2027,5.0000 L8.7967,5.0000 L9.9997,3.5860 Z M17.9997,12.0000 C17.9997,12.5520 17.5527,13.0000 16.9997,13.0000 L14.9997,13.0000 C13.8957,13.0000 12.9997,13.8950 12.9997,15.0000 L12.9997,17.0000 C12.9997,17.5520 12.5527,18.0000 11.9997,18.0000 L7.9997,18.0000 C7.4477,18.0000 6.9997,17.5520 6.9997,17.0000 L6.9997,15.0000 C6.9997,13.8950 6.1047,13.0000 4.9997,13.0000 L2.9997,13.0000 C2.4477,13.0000 1.9997,12.5520 1.9997,12.0000 L1.9997,8.0000 C1.9997,7.4480 2.4477,7.0000 2.9997,7.0000 L4.9997,7.0000 C6.1047,7.0000 6.9997,6.1050 6.9997,5.0000 L6.9997,3.0000 C6.9997,2.4480 7.4477,2.0000 7.9997,2.0000 L11.9997,2.0000 C12.5527,2.0000 12.9997,2.4480 12.9997,3.0000 L12.9997,5.0000 C12.9997,6.1050 13.8957,7.0000 14.9997,7.0000 L16.9997,7.0000 C17.5527,7.0000 17.9997,7.4480 17.9997,8.0000 L17.9997,12.0000 Z M17.9997,5.0000 L15.9997,5.0000 C15.4477,5.0000 14.9997,4.5520 14.9997,4.0000 L14.9997,2.0000 C14.9997,0.8950 14.1047,0.0000 12.9997,0.0000 L6.9997,0.0000 C5.8957,0.0000 4.9997,0.8950 4.9997,2.0000 L4.9997,4.0000 C4.9997,4.5520 4.5527,5.0000 3.9997,5.0000 L1.9997,5.0000 C0.8957,5.0000 -0.0003,5.8950 -0.0003,7.0000 L-0.0003,13.0010 C-0.0003,14.1050 0.8947,15.0000 1.9987,15.0000 L4.0007,15.0000 C4.5527,15.0000 4.9997,15.4500 4.9997,16.0020 L4.9997,18.0000 C4.9997,19.1050 5.8957,20.0000 6.9997,20.0000 L12.9997,20.0000 C14.1047,20.0000 14.9997,19.1050 14.9997,18.0000 L14.9997,16.0000 C14.9997,15.4480 15.4477,15.0000 15.9997,15.0000 L17.9997,15.0000 C19.1047,15.0000 19.9997,14.1050 19.9997,13.0000 L19.9997,7.0000 C19.9997,5.8950 19.1047,5.0000 17.9997,5.0000 L17.9997,5.0000 Z" Fill="{ThemeResource PadmonHighlightBrush}" />
                </Viewbox>
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Display"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="padmon" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="controller monitor" />
            </StackPanel>

        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            Background="Transparent"
            CompactPaneLength="52"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.Resources>
                <!-- Hide the template's built-in content panel chrome; the Border around the
                     Frame below draws the panel instead so its top edge can be offset. -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Margin="0"
                    Content="Controllers"
                    Tag="controllers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Margin="0"
                    Content="History"
                    Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Margin="12,8,12,14" Spacing="10">
                    <TextBlock
                        x:Name="BuildInfoText"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="0.0.0 · SDL 0.0.0" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="SettingsFooterButton"
                            Height="34"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.Name="Settings"
                            Click="FooterSettings_Click"
                            ToolTipService.ToolTip="Settings">
                            <FontIcon FontSize="16" Glyph="&#xE713;" />
                        </Button>
                        <Button
                            x:Name="UpdateFooterButton"
                            Grid.Column="1"
                            Height="34"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.Name="Update"
                            Click="FooterUpdate_Click"
                            ToolTipService.ToolTip="Update">
                            <FontIcon FontSize="16" Glyph="&#xE895;" />
                        </Button>
                    </Grid>
                </StackPanel>
            </NavigationView.PaneFooter>

            <!-- Top margin (5) lines the panel's top edge up with the selected nav item highlight. -->
            <Border
                Margin="0,5,0,0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <Frame x:Name="ContentFrame" Margin="0,10,0,0" />
            </Border>
        </NavigationView>
    </Grid>
</Window>
