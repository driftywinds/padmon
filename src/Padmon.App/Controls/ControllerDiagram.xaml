<UserControl
    x:Class="Padmon.Controls.ControllerDiagram"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DiagramBodyFillBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DiagramShadowBrush" Color="#EDF3FA" />
                    <SolidColorBrush x:Key="DiagramOutlineBrush" Color="#C5D6EA" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DiagramBodyFillBrush" Color="#1F2227" />
                    <SolidColorBrush x:Key="DiagramShadowBrush" Color="#2A303B" />
                    <SolidColorBrush x:Key="DiagramOutlineBrush" Color="#4C5A70" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="DiagramBodyFillBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="DiagramShadowBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="DiagramOutlineBrush" Color="Gray" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
    <Canvas Width="1120" Height="1010">

        <!-- Body shadow, body, and the faint inner creases -->
        <Path
            Data="M 330,268 L 790,268 C 880,268 935,310 965,390 C 1000,490 1050,640 1070,760 C 1082,860 1062,930 985,945 C 920,952 880,900 850,860 C 815,810 790,750 735,750 L 370,750 C 320,750 290,800 250,860 C 215,905 190,945 148,946 C 70,945 38,880 48,780 C 60,680 100,560 135,450 C 160,370 190,300 250,280 C 280,270 305,268 330,268 Z"
            Fill="{ThemeResource DiagramShadowBrush}">
            <Path.RenderTransform>
                <TranslateTransform Y="45" />
            </Path.RenderTransform>
        </Path>
        <Path
            Data="M 330,268 L 790,268 C 880,268 935,310 965,390 C 1000,490 1050,640 1070,760 C 1082,860 1062,930 985,945 C 920,952 880,900 850,860 C 815,810 790,750 735,750 L 370,750 C 320,750 290,800 250,860 C 215,905 190,945 148,946 C 70,945 38,880 48,780 C 60,680 100,560 135,450 C 160,370 190,300 250,280 C 280,270 305,268 330,268 Z"
            Fill="{ThemeResource DiagramBodyFillBrush}"
            Stroke="{ThemeResource DiagramOutlineBrush}"
            StrokeLineJoin="Round"
            StrokeThickness="5" />
        <Line
            X1="110" Y1="548" X2="345" Y2="750"
            Stroke="{ThemeResource DiagramShadowBrush}"
            StrokeThickness="3" />
        <Line
            X1="1010" Y1="548" X2="775" Y2="750"
            Stroke="{ThemeResource DiagramShadowBrush}"
            StrokeThickness="3" />

        <!-- Wells: D-pad, face buttons, sticks -->
        <Ellipse Canvas.Left="215" Canvas.Top="338" Width="180" Height="180" Stroke="{ThemeResource DiagramOutlineBrush}" StrokeThickness="5" />
        <Ellipse Canvas.Left="728" Canvas.Top="338" Width="180" Height="180" Stroke="{ThemeResource DiagramOutlineBrush}" StrokeThickness="5" />
        <Ellipse Canvas.Left="342" Canvas.Top="523" Width="180" Height="180" Stroke="{ThemeResource DiagramOutlineBrush}" StrokeThickness="5" />
        <Ellipse Canvas.Left="608" Canvas.Top="524" Width="180" Height="180" Stroke="{ThemeResource DiagramOutlineBrush}" StrokeThickness="5" />

        <!-- Triggers (fill fades from transparent to red) -->
        <Rectangle x:Name="LeftTriggerFill" Canvas.Left="332" Canvas.Top="55" Width="68" Height="98" RadiusX="32" RadiusY="32" Fill="#E53935" Opacity="0" />
        <Rectangle Canvas.Left="332" Canvas.Top="55" Width="68" Height="98" RadiusX="32" RadiusY="32" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="5" />
        <Rectangle x:Name="RightTriggerFill" Canvas.Left="724" Canvas.Top="55" Width="69" Height="98" RadiusX="32" RadiusY="32" Fill="#E53935" Opacity="0" />
        <Rectangle Canvas.Left="724" Canvas.Top="55" Width="69" Height="98" RadiusX="32" RadiusY="32" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="5" />

        <!-- Bumpers -->
        <Rectangle x:Name="LeftBumper" Canvas.Left="300" Canvas.Top="193" Width="100" Height="33" RadiusX="16" RadiusY="16" Fill="Transparent" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="5" />
        <Rectangle x:Name="RightBumper" Canvas.Left="724" Canvas.Top="193" Width="100" Height="33" RadiusX="16" RadiusY="16" Fill="Transparent" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="5" />

        <!-- Back / Start -->
        <Ellipse x:Name="BackButton" Canvas.Left="452" Canvas.Top="409" Width="48" Height="48" Fill="Transparent" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="5" />
        <Ellipse x:Name="StartButton" Canvas.Left="628" Canvas.Top="409" Width="48" Height="48" Fill="Transparent" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="5" />

        <!-- D-pad and face buttons -->
        <Path
            x:Name="DPadUp"
            Data="M 283,362 Q 305,355 327,362 Q 338,367 333,378 L 316,401 Q 305,411 294,401 L 277,378 Q 272,367 283,362 Z"
            Fill="Transparent"
            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
            StrokeLineJoin="Round"
            StrokeThickness="5">
            <Path.RenderTransform>
                <RotateTransform Angle="0" CenterX="305" CenterY="428" />
            </Path.RenderTransform>
        </Path>
        <Path
            x:Name="DPadRight"
            Data="M 283,362 Q 305,355 327,362 Q 338,367 333,378 L 316,401 Q 305,411 294,401 L 277,378 Q 272,367 283,362 Z"
            Fill="Transparent"
            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
            StrokeLineJoin="Round"
            StrokeThickness="5">
            <Path.RenderTransform>
                <RotateTransform Angle="90" CenterX="305" CenterY="428" />
            </Path.RenderTransform>
        </Path>
        <Path
            x:Name="DPadDown"
            Data="M 283,362 Q 305,355 327,362 Q 338,367 333,378 L 316,401 Q 305,411 294,401 L 277,378 Q 272,367 283,362 Z"
            Fill="Transparent"
            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
            StrokeLineJoin="Round"
            StrokeThickness="5">
            <Path.RenderTransform>
                <RotateTransform Angle="180" CenterX="305" CenterY="428" />
            </Path.RenderTransform>
        </Path>
        <Path
            x:Name="DPadLeft"
            Data="M 283,362 Q 305,355 327,362 Q 338,367 333,378 L 316,401 Q 305,411 294,401 L 277,378 Q 272,367 283,362 Z"
            Fill="Transparent"
            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
            StrokeLineJoin="Round"
            StrokeThickness="5">
            <Path.RenderTransform>
                <RotateTransform Angle="270" CenterX="305" CenterY="428" />
            </Path.RenderTransform>
        </Path>
        <Path
            x:Name="FaceY"
            Data="M 796,362 Q 818,355 840,362 Q 851,367 846,378 L 829,401 Q 818,411 807,401 L 790,378 Q 785,367 796,362 Z"
            Fill="Transparent"
            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
            StrokeLineJoin="Round"
            StrokeThickness="5">
            <Path.RenderTransform>
                <RotateTransform Angle="0" CenterX="818" CenterY="428" />
            </Path.RenderTransform>
        </Path>
        <Path
            x:Name="FaceB"
            Data="M 796,362 Q 818,355 840,362 Q 851,367 846,378 L 829,401 Q 818,411 807,401 L 790,378 Q 785,367 796,362 Z"
            Fill="Transparent"
            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
            StrokeLineJoin="Round"
            StrokeThickness="5">
            <Path.RenderTransform>
                <RotateTransform Angle="90" CenterX="818" CenterY="428" />
            </Path.RenderTransform>
        </Path>
        <Path
            x:Name="FaceA"
            Data="M 796,362 Q 818,355 840,362 Q 851,367 846,378 L 829,401 Q 818,411 807,401 L 790,378 Q 785,367 796,362 Z"
            Fill="Transparent"
            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
            StrokeLineJoin="Round"
            StrokeThickness="5">
            <Path.RenderTransform>
                <RotateTransform Angle="180" CenterX="818" CenterY="428" />
            </Path.RenderTransform>
        </Path>
        <Path
            x:Name="FaceX"
            Data="M 796,362 Q 818,355 840,362 Q 851,367 846,378 L 829,401 Q 818,411 807,401 L 790,378 Q 785,367 796,362 Z"
            Fill="Transparent"
            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
            StrokeLineJoin="Round"
            StrokeThickness="5">
            <Path.RenderTransform>
                <RotateTransform Angle="270" CenterX="818" CenterY="428" />
            </Path.RenderTransform>
        </Path>

        <!-- Sticks: knob backdrop hides the well; knob turns red when moved or clicked -->
        <Ellipse Canvas.Left="364" Canvas.Top="545" Width="136" Height="136" Fill="{ThemeResource DiagramBodyFillBrush}">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="LeftKnobBackdropMove" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="LeftKnob" Canvas.Left="364" Canvas.Top="545" Width="136" Height="136" Fill="Transparent" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="5">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="LeftKnobMove" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Canvas.Left="630" Canvas.Top="546" Width="136" Height="136" Fill="{ThemeResource DiagramBodyFillBrush}">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="RightKnobBackdropMove" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="RightKnob" Canvas.Left="630" Canvas.Top="546" Width="136" Height="136" Fill="Transparent" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="5">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="RightKnobMove" />
            </Ellipse.RenderTransform>
        </Ellipse>

    </Canvas>
    </Viewbox>
</UserControl>
