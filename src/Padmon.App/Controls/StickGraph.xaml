<UserControl
    x:Class="Padmon.Controls.StickGraph"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="130"
    Height="130">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="StickGraphGridBrush" Color="#D5DEEA" />
                    <SolidColorBrush x:Key="StickGraphInkBrush" Color="#0B3A6B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="StickGraphGridBrush" Color="#3E4859" />
                    <SolidColorBrush x:Key="StickGraphInkBrush" Color="#7FB6FF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="StickGraphGridBrush" Color="Gray" />
                    <SolidColorBrush x:Key="StickGraphInkBrush" Color="White" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Canvas Width="130" Height="130">
        <Ellipse
            Canvas.Left="5"
            Canvas.Top="5"
            Width="120"
            Height="120"
            Stroke="{ThemeResource StickGraphGridBrush}"
            StrokeThickness="1.5" />
        <Line
            X1="65" Y1="5" X2="65" Y2="125"
            Stroke="{ThemeResource StickGraphGridBrush}"
            StrokeThickness="1.5" />
        <Line
            X1="5" Y1="65" X2="125" Y2="65"
            Stroke="{ThemeResource StickGraphGridBrush}"
            StrokeThickness="1.5" />
        <Line
            x:Name="Needle"
            X1="65" Y1="65" X2="65" Y2="65"
            Stroke="{ThemeResource StickGraphInkBrush}"
            StrokeThickness="1.5" />
        <Ellipse
            x:Name="Dot"
            Canvas.Left="60"
            Canvas.Top="60"
            Width="10"
            Height="10"
            Fill="{ThemeResource StickGraphInkBrush}" />
    </Canvas>
</UserControl>
