<Page
    x:Class="Padmon.Views.CouchControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Padmon.ViewModels"
    Background="Transparent"
    NavigationCacheMode="Required">

    <ScrollViewer
        x:Name="PageScroll"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="PageRoot"
            Width="{Binding ViewportWidth, ElementName=PageScroll}"
            MinHeight="{Binding ViewportHeight, ElementName=PageScroll}"
            Style="{StaticResource PageRootStyle}">
            <StackPanel Spacing="22">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Couch Control" />
                    <TextBlock
                        Style="{StaticResource PageSubtitleStyle}"
                        Text="Use a controller as a Windows keyboard and mouse. Built for portable padmon." />
                </StackPanel>

                <InfoBar
                    x:Name="AvailabilityBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning"
                    Title="Couch Control is portable-only"
                    Message="This feature is disabled in the Microsoft Store build because it injects keyboard and mouse input into other applications." />

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Enable Couch Control" />
                                <TextBlock
                                    Style="{StaticResource CardSubtitleStyle}"
                                    Text="Turn controller input into Windows keyboard and mouse input. Press L3 + R3 together to release it instantly." />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="EnableToggle"
                                Grid.Column="1"
                                MinWidth="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Enable Couch Control"
                                OffContent=""
                                OnContent=""
                                Toggled="EnableToggle_Toggled" />
                        </Grid>

                        <Border Style="{StaticResource DividerStyle}" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Controller" />
                                <TextBlock
                                    Style="{StaticResource CardSubtitleStyle}"
                                    Text="Only the selected controller drives Windows. DInput/PS4-mode controllers work through the same SDL pipeline as the tester." />
                            </StackPanel>
                            <ComboBox
                                x:Name="ControllerPicker"
                                Grid.Column="1"
                                MinWidth="240"
                                VerticalAlignment="Center"
                                DisplayMemberPath="DisplayName"
                                PlaceholderText="No controllers connected"
                                SelectionChanged="ControllerPicker_SelectionChanged" />
                        </Grid>

                        <TextBlock
                            x:Name="StatusText"
                            Style="{StaticResource CaptionStyle}"
                            Text="Off"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Mappings" />
                                <TextBlock
                                    Style="{StaticResource CardSubtitleStyle}"
                                    Text="One keyboard key or mouse action per controller control. The default layout mirrors classic Gopher." />
                            </StackPanel>
                            <HyperlinkButton
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="ResetMappings_Click"
                                Content="Reset mappings"
                                FontSize="12"
                                Padding="0" />
                        </Grid>

                        <ItemsRepeater ItemsSource="{x:Bind MappingRows}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:CouchMappingRow">
                                    <Grid
                                        Margin="0,8"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource BodyStyle}"
                                            Text="{x:Bind Label}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            MinWidth="150"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CaptionStyle}"
                                            Text="{x:Bind BindingText}"
                                            TextAlignment="Right" />
                                        <Button
                                            Grid.Column="2"
                                            Click="ChangeMapping_Click"
                                            Content="Change"
                                            Tag="{x:Bind Id}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Pointer and scrolling" />
                            <TextBlock
                                Style="{StaticResource CardSubtitleStyle}"
                                Text="Changes apply immediately and are saved automatically." />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStyle}" Text="Pointer speed" />
                            <Slider
                                x:Name="CursorSpeedSlider"
                                Maximum="2400"
                                StepFrequency="50"
                                ValueChanged="CursorSpeed_ValueChanged" />
                            <TextBlock
                                x:Name="CursorSpeedText"
                                Style="{StaticResource CaptionStyle}"
                                Text="900 px/s" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStyle}" Text="Stick dead zone" />
                            <Slider
                                x:Name="DeadZoneSlider"
                                Maximum="20000"
                                StepFrequency="100"
                                ValueChanged="DeadZone_ValueChanged" />
                            <TextBlock
                                x:Name="DeadZoneText"
                                Style="{StaticResource CaptionStyle}"
                                Text="6000 raw units" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStyle}" Text="Scroll dead zone" />
                            <Slider
                                x:Name="ScrollDeadZoneSlider"
                                Maximum="20000"
                                StepFrequency="100"
                                ValueChanged="ScrollDeadZone_ValueChanged" />
                            <TextBlock
                                x:Name="ScrollDeadZoneText"
                                Style="{StaticResource CaptionStyle}"
                                Text="5000 raw units" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStyle}" Text="Scroll speed" />
                            <Slider
                                x:Name="ScrollSpeedSlider"
                                Maximum="40"
                                StepFrequency="1"
                                ValueChanged="ScrollSpeed_ValueChanged" />
                            <TextBlock
                                x:Name="ScrollSpeedText"
                                Style="{StaticResource CaptionStyle}"
                                Text="8 notches/sec" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStyle}" Text="Pointer acceleration" />
                            <Slider
                                x:Name="AccelerationSlider"
                                Maximum="2"
                                StepFrequency="0.1"
                                ValueChanged="Acceleration_ValueChanged" />
                            <TextBlock
                                x:Name="AccelerationText"
                                Style="{StaticResource CaptionStyle}"
                                Text="0×" />
                        </StackPanel>

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource BodyStyle}" Text="Swap sticks" />
                                <TextBlock
                                    Style="{StaticResource CaptionStyle}"
                                    Text="Use the right stick for the pointer and the left for scrolling." />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SwapSticksToggle"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Toggled="SwapSticks_Toggled" />
                        </Grid>

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource BodyStyle}" Text="Pause while padmon is focused" />
                                <TextBlock
                                    Style="{StaticResource CaptionStyle}"
                                    Text="Keep the app usable without the controller moving the pointer over it." />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="PauseWhenFocusedToggle"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Toggled="PauseWhenFocused_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="Why Couch Control is portable-only" />
                        <TextBlock
                            Style="{StaticResource CardSubtitleStyle}"
                            Text="padmon injects keyboard and mouse input into whichever app has focus. The Microsoft Store build deliberately excludes that capability; the portable and normal-install builds keep it available."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource CaptionStyle}"
                            Text="Windows blocks synthetic input into elevated windows. Anti-cheat software may also treat injected input as automation."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
