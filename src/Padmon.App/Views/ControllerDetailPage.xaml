<Page
    x:Class="Padmon.Views.ControllerDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Padmon.Controls"
    xmlns:vm="using:Padmon.ViewModels"
    Background="Transparent"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="PadAccentBrush" Color="#E53935" />

        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="ReadoutValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- Label, number and level bar, like the value cells on hardwaretester.com -->
        <DataTemplate x:Key="PadCellTemplate" x:DataType="vm:PadCellViewModel">
            <Grid ColumnSpacing="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="5"
                    Height="34"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Border
                        Height="{x:Bind FillHeight, Mode=OneWay}"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource PadAccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Label, Mode=OneWay}" />
                    <TextBlock
                        FontSize="17"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind ValueText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer
        x:Name="PageScroll"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="PageRoot"
            Width="{Binding ViewportWidth, ElementName=PageScroll}"
            MinHeight="{Binding ViewportHeight, ElementName=PageScroll}"
            SizeChanged="PageRoot_SizeChanged"
            Style="{StaticResource PageRootStyle}">
            <StackPanel Spacing="22">

                <Button
                    x:Name="BackButton"
                    Click="Back_Click"
                    Content="Back to controllers"
                    HorizontalAlignment="Left" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock
                            x:Name="ControllerName"
                            Style="{StaticResource PageTitleStyle}"
                            Text="Controller" />
                        <TextBlock
                            x:Name="ControllerSubtitle"
                            Style="{StaticResource PageSubtitleStyle}"
                            Text="Live input tester" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Border
                            Padding="10,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="12">
                            <TextBlock
                                x:Name="BatteryText"
                                Style="{StaticResource PillTextStyle}"
                                Text="Battery unknown" />
                        </Border>
                        <Button
                            Click="Rumble_Click"
                            Content="Test rumble" />
                    </StackPanel>
                </Grid>

                <InfoBar
                    x:Name="DisconnectedBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning"
                    Title="Controller disconnected"
                    Message="The last input state is still shown below." />

                <InfoBar
                    x:Name="PreviewBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Informational"
                    Title="Preview mode"
                    Message="No controller is connected, so this shows simulated input to let you check the tester layout. Connect a controller to test it for real." />

                <InfoBar
                    x:Name="RumbleBar"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Informational"
                    Title="Rumble unavailable"
                    Message="Windows did not expose a rumble motor for this controller in its current mode." />

                <Grid
                    x:Name="DiagramView"
                    ColumnSpacing="40"
                    RowSpacing="28"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        x:Name="StatsPanel"
                        Grid.Row="0"
                        Grid.Column="0"
                        Spacing="26">

                        <Grid ColumnSpacing="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="INDEX" />
                                <TextBlock x:Name="IndexText" Style="{StaticResource StatValueStyle}" Text="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="CONNECTED" />
                                <TextBlock Style="{StaticResource StatValueStyle}" Text="{x:Bind Tester.ConnectedText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="MAPPING" />
                                <TextBlock Style="{StaticResource StatValueStyle}" Text="{x:Bind Tester.MappingText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Width="150">
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="TIMESTAMP" />
                                <TextBlock Style="{StaticResource StatValueStyle}" Text="{x:Bind Tester.TimestampText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="VIBRATION" />
                                <TextBlock Style="{StaticResource StatValueStyle}" Text="{x:Bind Tester.VibrationText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <ItemsRepeater ItemsSource="{x:Bind Tester.PadButtonCells}" ItemTemplate="{StaticResource PadCellTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="10"
                                    MinItemWidth="84"
                                    MinRowSpacing="12" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>

                        <Grid ColumnSpacing="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="L STICK" />
                                <StackPanel Orientation="Horizontal" Spacing="22">
                                    <ItemsRepeater ItemsSource="{x:Bind Tester.LeftAxisCells}" ItemTemplate="{StaticResource PadCellTemplate}" VerticalAlignment="Center" Width="104">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="14" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                    <controls:StickGraph x:Name="LeftGraph" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="10">
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="R STICK" />
                                <StackPanel Orientation="Horizontal" Spacing="22">
                                    <ItemsRepeater ItemsSource="{x:Bind Tester.RightAxisCells}" ItemTemplate="{StaticResource PadCellTemplate}" VerticalAlignment="Center" Width="104">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="14" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                    <controls:StickGraph x:Name="RightGraph" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border
                        x:Name="DiagramPanel"
                        Grid.Row="0"
                        Grid.Column="1"
                        Width="470"
                        VerticalAlignment="Top"
                        Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="18">
                            <controls:ControllerDiagram x:Name="Diagram" />
                            <Border Style="{StaticResource DividerStyle}" />
                            <Grid ColumnSpacing="14" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Style="{StaticResource StatLabelStyle}" Text="L STICK" />
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="X" />
                                <TextBlock Style="{StaticResource ReadoutValueStyle}" Text="{x:Bind Tester.LeftXText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="Y" />
                                <TextBlock Style="{StaticResource ReadoutValueStyle}" Text="{x:Bind Tester.LeftYText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="3">
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="MAGNITUDE" />
                                <TextBlock Style="{StaticResource ReadoutValueStyle}" Text="{x:Bind Tester.LeftMagnitudeText, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Style="{StaticResource StatLabelStyle}" Text="R STICK" />
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="X" />
                                <TextBlock Style="{StaticResource ReadoutValueStyle}" Text="{x:Bind Tester.RightXText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="Y" />
                                <TextBlock Style="{StaticResource ReadoutValueStyle}" Text="{x:Bind Tester.RightYText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3">
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="MAGNITUDE" />
                                <TextBlock Style="{StaticResource ReadoutValueStyle}" Text="{x:Bind Tester.RightMagnitudeText, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Style="{StaticResource StatLabelStyle}" Text="TRIGGERS" />
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="LT" />
                                <TextBlock Style="{StaticResource ReadoutValueStyle}" Text="{x:Bind Tester.LeftTriggerValueText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="RT" />
                                <TextBlock Style="{StaticResource ReadoutValueStyle}" Text="{x:Bind Tester.RightTriggerValueText, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Style="{StaticResource StatLabelStyle}" Text="BUMPERS" />
                            <StackPanel Grid.Row="3" Grid.Column="1">
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="LB" />
                                <TextBlock Style="{StaticResource ReadoutValueStyle}" Text="{x:Bind Tester.LeftBumperText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2">
                                <TextBlock Style="{StaticResource StatLabelStyle}" Text="RB" />
                                <TextBlock Style="{StaticResource ReadoutValueStyle}" Text="{x:Bind Tester.RightBumperText, Mode=OneWay}" />
                            </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel x:Name="ClassicView" Spacing="22">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="18">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Sticks" />
                                    <TextBlock Style="{StaticResource CardSubtitleStyle}" Text="X and Y, normalized from -1 to 1." />
                                </StackPanel>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="10">
                                        <Grid Width="142" Height="142" HorizontalAlignment="Center">
                                            <Ellipse
                                                Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                                StrokeThickness="1" />
                                            <Ellipse
                                                Width="96"
                                                Height="96"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                                StrokeDashArray="3,4"
                                                StrokeThickness="1" />
                                            <Ellipse
                                                x:Name="LeftStickDot"
                                                Width="22"
                                                Height="22"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Fill="{ThemeResource AccentFillColorDefaultBrush}">
                                                <Ellipse.RenderTransform>
                                                    <TranslateTransform x:Name="LeftStickTransform" />
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource CaptionStyle}"
                                            Text="Left stick" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource MonoStyle}"
                                            Text="{x:Bind Tester.LeftStickText, Mode=OneWay}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="10">
                                        <Grid Width="142" Height="142" HorizontalAlignment="Center">
                                            <Ellipse
                                                Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                                StrokeThickness="1" />
                                            <Ellipse
                                                Width="96"
                                                Height="96"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                                StrokeDashArray="3,4"
                                                StrokeThickness="1" />
                                            <Ellipse
                                                x:Name="RightStickDot"
                                                Width="22"
                                                Height="22"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Fill="{ThemeResource AccentFillColorDefaultBrush}">
                                                <Ellipse.RenderTransform>
                                                    <TranslateTransform x:Name="RightStickTransform" />
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource CaptionStyle}"
                                            Text="Right stick" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource MonoStyle}"
                                            Text="{x:Bind Tester.RightStickText, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Triggers" />
                                    <TextBlock Style="{StaticResource CardSubtitleStyle}" Text="Analog shoulder travel, 0 to 100%." />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="LT" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource MonoStyle}"
                                            Text="{x:Bind Tester.LeftTriggerText, Mode=OneWay}" />
                                    </Grid>
                                    <ProgressBar
                                        Height="8"
                                        Maximum="100"
                                        Value="{x:Bind Tester.LeftTriggerPercent, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="RT" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource MonoStyle}"
                                            Text="{x:Bind Tester.RightTriggerText, Mode=OneWay}" />
                                    </Grid>
                                    <ProgressBar
                                        Height="8"
                                        Maximum="100"
                                        Value="{x:Bind Tester.RightTriggerPercent, Mode=OneWay}" />
                                </StackPanel>

                                <Border Style="{StaticResource DividerStyle}" />

                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Shoulder buttons" />
                                    <TextBlock
                                        Style="{StaticResource BodyStyle}"
                                        Text="LB and RB light up in the button grid below." />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Style="{StaticResource CaptionStyle}"
                                        Text="Digital bumpers and extra paddles are reported as buttons by SDL." />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Buttons" />
                                    <TextBlock Style="{StaticResource CardSubtitleStyle}" Text="Every exposed button, live." />
                                </StackPanel>
                                <Border
                                    HorizontalAlignment="Right"
                                    Padding="9,3"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="10">
                                    <TextBlock
                                        x:Name="MappingBadge"
                                        Style="{StaticResource PillTextStyle}"
                                        Text="MAPPED" />
                                </Border>
                            </Grid>

                            <ItemsRepeater ItemsSource="{x:Bind Tester.Buttons}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsStretch="Fill"
                                        MinColumnSpacing="8"
                                        MinItemWidth="94"
                                        MinRowSpacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ButtonStateViewModel">
                                        <ToggleButton
                                            HorizontalAlignment="Stretch"
                                            Content="{x:Bind Label}"
                                            FontSize="12"
                                            IsChecked="{x:Bind IsPressed, Mode=OneWay}"
                                            IsHitTestVisible="False"
                                            IsTabStop="False" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Raw axes" />
                                    <TextBlock Style="{StaticResource CardSubtitleStyle}" Text="Normalized value, then the raw SDL reading." />
                                </StackPanel>

                                <ItemsRepeater ItemsSource="{x:Bind Tester.Axes}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AxisStateViewModel">
                                            <Grid>
                                                <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind Label}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource MonoStyle}"
                                                    Text="{x:Bind ValueText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Device" />
                                    <TextBlock Style="{StaticResource CardSubtitleStyle}" Text="What padmon knows about this controller." />
                                </StackPanel>

                                <Grid ColumnSpacing="12" RowSpacing="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Hardware" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource BodyStyle}"
                                        Text="{x:Bind Tester.HardwareName, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Style="{StaticResource CaptionStyle}"
                                        Text="Type" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource BodyStyle}"
                                        Text="{x:Bind Tester.KindLabel, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Style="{StaticResource CaptionStyle}"
                                        Text="Connection" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Style="{StaticResource BodyStyle}"
                                        Text="{x:Bind Tester.ConnectionLabel, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Style="{StaticResource CaptionStyle}"
                                        Text="Stable key" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Style="{StaticResource MonoStyle}"
                                        Text="{x:Bind Tester.StableKey, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="4"
                                        Style="{StaticResource CaptionStyle}"
                                        Text="Hats" />
                                    <ItemsRepeater
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        ItemsSource="{x:Bind Tester.Hats}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="4" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:HatStateViewModel">
                                                <TextBlock Style="{StaticResource MonoStyle}" Text="{x:Bind ValueText}" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </Grid>

                                <TextBlock
                                    Margin="0,8,0,0"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="padmon reads these values; it does not change them." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
