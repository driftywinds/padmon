<Page
    x:Class="Padmon.Views.ControllersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Padmon.ViewModels"
    Background="Transparent"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="PageScroll"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="PageRoot"
            Width="{Binding ViewportWidth, ElementName=PageScroll}"
            MinHeight="{Binding ViewportHeight, ElementName=PageScroll}"
            SizeChanged="PageRoot_SizeChanged"
            Style="{StaticResource PageRootStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Controllers" />
                    <TextBlock
                        Style="{StaticResource PageSubtitleStyle}"
                        Text="What's connected right now. padmon notices changes automatically." />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionStyle}"
                        Text="{x:Bind ViewModel.ConnectedCount, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionStyle}"
                        Text="connected" />
                    <Border
                        x:Name="MonitoringBadge"
                        Padding="10,4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse
                                x:Name="MonitoringDot"
                                Width="7"
                                Height="7"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock
                                x:Name="MonitoringText"
                                Style="{StaticResource PillTextStyle}"
                                Text="Watching" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <InfoBar
                x:Name="ErrorBar"
                Grid.Row="1"
                Margin="0,16,0,0"
                IsClosable="True"
                IsOpen="False"
                Severity="Error"
                Title="Input problem" />

            <Grid
                x:Name="BodyGrid"
                Grid.Row="2"
                Margin="0,24,0,0"
                ColumnSpacing="0"
                RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="PrimaryPanel"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2">
                    <Grid
                        x:Name="EmptyPanel"
                        VerticalAlignment="Stretch">
                        <Border
                            MinHeight="360"
                            VerticalAlignment="Stretch"
                            Style="{StaticResource CardBorderStyle}">
                            <StackPanel
                                MaxWidth="460"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="14">
                                <Border Style="{StaticResource EmptyStateGlyphCircleStyle}">
                                    <FontIcon
                                        FontSize="40"
                                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                        Glyph="&#xE7FC;" />
                                </Border>
                                <TextBlock
                                    Style="{StaticResource LargeEmptyTitleStyle}"
                                    Text="No controllers connected" />
                                <TextBlock
                                    Style="{StaticResource LargeEmptyBodyStyle}"
                                    Text="Plug one in, or pair it over Bluetooth. padmon will notice it without any setup." />
                                <StackPanel
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="7">
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock
                                        Style="{StaticResource CaptionStyle}"
                                        Text="Watching for controllers" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel
                        x:Name="ConnectedPanel"
                        Spacing="12"
                        Visibility="Collapsed">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Controllers}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="12"
                                    MinItemWidth="320"
                                    MinRowSpacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ControllerViewModel">
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <StackPanel Spacing="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Width="52"
                                                    Height="52"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="16">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe UI Variable Display"
                                                        FontSize="16"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        Text="{x:Bind Initials}" />
                                                </Border>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="12,0,12,0"
                                                    VerticalAlignment="Center"
                                                    Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock
                                                            MaxLines="1"
                                                            MaxWidth="210"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource CardTitleStyle}"
                                                            Text="{x:Bind DisplayName, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Border
                                                            Padding="7,2"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            CornerRadius="8"
                                                            Visibility="{x:Bind IsNew, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock
                                                                FontSize="9"
                                                                FontWeight="SemiBold"
                                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                Text="NEW" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock
                                                        MaxLines="1"
                                                        Style="{StaticResource CardSubtitleStyle}"
                                                        Text="{x:Bind Subtitle, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                                    <Button
                                                        AutomationProperties.Name="Rename controller"
                                                        Click="Rename_Click"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Tag="{x:Bind StableKey}"
                                                        ToolTipService.ToolTip="Rename controller">
                                                        <FontIcon FontSize="13" Glyph="&#xE70F;" />
                                                    </Button>
                                                    <Border
                                                        Padding="9,4"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="10"
                                                        Visibility="{x:Bind HasBattery, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock
                                                            Style="{StaticResource PillTextStyle}"
                                                            Text="{x:Bind BatteryLabel, Mode=OneWay}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <Border Style="{StaticResource DividerStyle}" />

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    Click="MoreInfo_Click"
                                                    Content="More information"
                                                    Tag="{x:Bind StableKey}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Click="TestInputs_Click"
                                                    Content="Test inputs"
                                                    Tag="{x:Bind StableKey}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Grid>

                <StackPanel
                    x:Name="SecondaryPanel"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Top"
                    Spacing="10"
                    Visibility="Collapsed">
                    <Grid>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Previously connected" />
                        <HyperlinkButton
                            HorizontalAlignment="Right"
                            Click="ViewHistory_Click"
                            Content="View all" />
                    </Grid>

                    <Border
                        x:Name="HistoryEmptyCard"
                        VerticalAlignment="Stretch"
                        Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="12">
                                <FontIcon
                                    FontSize="18"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE81C;" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="14,0,14,0"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="No past controllers yet" />
                                <TextBlock
                                    Style="{StaticResource CardSubtitleStyle}"
                                    Text="Disconnect a controller and it will appear here with its name and last-seen time." />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </Border>

                    <Border
                        x:Name="HistoryListCard"
                        Padding="0"
                        Style="{StaticResource CardBorderStyle}"
                        Visibility="Collapsed">
                        <ItemsRepeater ItemsSource="{x:Bind PreviousControllers}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:KnownControllerViewModel">
                                    <Border
                                        Padding="16,12"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="38"
                                                Height="38"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="12">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Initials}" />
                                            </Border>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0,12,0"
                                                VerticalAlignment="Center"
                                                Spacing="1">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock
                                                        MaxLines="1"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource CardTitleStyle}"
                                                        Text="{x:Bind DisplayName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Border
                                                        Padding="8,2"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="8"
                                                        Visibility="{x:Bind IsMerged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                            Text="{x:Bind MergedLabel}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock
                                                    MaxLines="1"
                                                    Style="{StaticResource CardSubtitleStyle}"
                                                    Text="{x:Bind HardwareName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    Style="{StaticResource CaptionStyle}"
                                                    Text="{x:Bind LastSeenText}"
                                                    TextWrapping="NoWrap" />
                                                <TextBlock
                                                    Style="{StaticResource CaptionStyle}"
                                                    Text="{x:Bind SessionText}"
                                                    TextWrapping="NoWrap" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{x:Bind MergeActionText}"
                                                Click="MergeHistory_Click"
                                                Content="{x:Bind MergeActionText}"
                                                Tag="{x:Bind Record.StableKey}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>

                    <Border
                        Margin="0,4,0,0"
                        Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Quick start" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="26"
                                    Height="26"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="13">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="1" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Style="{StaticResource BodyStyle}" Text="Connect a controller" />
                                    <TextBlock
                                        Style="{StaticResource CaptionStyle}"
                                        Text="padmon notices it automatically." />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="26"
                                    Height="26"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="13">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="2" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Style="{StaticResource BodyStyle}" Text="Open Test inputs" />
                                    <TextBlock
                                        Style="{StaticResource CaptionStyle}"
                                        Text="See every button and axis live." />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="26"
                                    Height="26"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="13">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="3" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Style="{StaticResource BodyStyle}" Text="Rename it" />
                                    <TextBlock
                                        Style="{StaticResource CaptionStyle}"
                                        Text="Keep the name in history and notifications." />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock
                Grid.Row="3"
                Margin="2,20,2,0"
                Style="{StaticResource CaptionStyle}"
                Text="padmon only reads controller state. It never remaps buttons or changes your devices." />
        </Grid>
    </ScrollViewer>
</Page>
