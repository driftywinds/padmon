<Page
    x:Class="Padmon.Views.UpdatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Disabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid
            MaxWidth="880"
            Padding="32,24,32,40"
            HorizontalAlignment="Left">
            <StackPanel Spacing="24">

                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Update" />
                    <TextBlock
                        Style="{StaticResource PageSubtitleStyle}"
                        Text="Check for a newer padmon release. Nothing is downloaded or installed automatically." />
                </StackPanel>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Installed version" />
                            <TextBlock
                                x:Name="CurrentVersionText"
                                Style="{StaticResource CardSubtitleStyle}"
                                Text="Version 0.0.0" />
                            <TextBlock
                                x:Name="BuildKindText"
                                Style="{StaticResource CaptionStyle}"
                                Text="Portable build" />
                        </StackPanel>
                        <Button
                            x:Name="CheckButton"
                            Grid.Column="1"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Check for updates"
                            Click="Check_Click"
                            Content="Check for updates" />
                    </Grid>
                </Border>

                <InfoBar
                    x:Name="StatusBar"
                    IsClosable="False"
                    IsOpen="False" />

                <Border
                    x:Name="AvailableCard"
                    Padding="24"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Update available" />
                            <TextBlock
                                x:Name="LatestVersionText"
                                Style="{StaticResource CardTitleStyle}"
                                Text="Version 0.0.0" />
                            <TextBlock
                                x:Name="PublishedText"
                                Style="{StaticResource CaptionStyle}"
                                Text="Latest GitHub release" />
                        </StackPanel>

                        <ScrollViewer
                            MaxHeight="220"
                            VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                x:Name="ReleaseNotesText"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </ScrollViewer>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                x:Name="InstallButton"
                                AutomationProperties.Name="Download and install update"
                                Click="Install_Click"
                                Content="Download and install" />
                            <HyperlinkButton
                                x:Name="ReleaseLinkButton"
                                Click="ReleaseLink_Click"
                                Content="View on GitHub" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="UpToDateCard"
                    Padding="24"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="You're up to date" />
                        <TextBlock
                            Style="{StaticResource CardSubtitleStyle}"
                            Text="You are running the latest published padmon release." />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="NoReleaseCard"
                    Padding="24"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="No published release yet" />
                        <TextBlock
                            Style="{StaticResource CardSubtitleStyle}"
                            Text="There is no GitHub release to compare against. Check again after the first release is published." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
