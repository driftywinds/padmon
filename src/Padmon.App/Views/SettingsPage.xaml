<Page
    x:Class="Padmon.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Required">

    <ScrollViewer
        x:Name="PageScroll"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="PageRoot"
            Width="{Binding ViewportWidth, ElementName=PageScroll}"
            MinHeight="{Binding ViewportHeight, ElementName=PageScroll}"
            SizeChanged="PageRoot_SizeChanged"
            Style="{StaticResource PageRootStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="How padmon watches, remembers, and lets you know." />
            </StackPanel>

            <Grid
                x:Name="SettingsBody"
                Grid.Row="1"
                Margin="0,26,0,0"
                ColumnSpacing="0"
                RowSpacing="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    x:Name="LeftSettings"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Spacing="26">

                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Monitoring" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Keep monitoring in the background" />
                                    <TextBlock
                                        Style="{StaticResource CardSubtitleStyle}"
                                        Text="padmon stays in the tray when you close the window, so it can watch for controllers and notify you." />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Keep monitoring in the background"
                                    IsOn="{x:Bind ViewModel.BackgroundMonitoring, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                            <Border Margin="0,14" Style="{StaticResource DividerStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Start with Windows" />
                                    <TextBlock
                                        x:Name="StartWithWindowsDescription"
                                        Style="{StaticResource CardSubtitleStyle}"
                                        Text="Launch padmon quietly into the tray when you sign in." />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Start with Windows"
                                    IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Notifications" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Controller connected" />
                                    <TextBlock
                                        Style="{StaticResource CardSubtitleStyle}"
                                        Text="Show a Windows notification when a controller connects." />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Controller connected"
                                    IsOn="{x:Bind ViewModel.NotifyOnConnect, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                            <Border Margin="0,14" Style="{StaticResource DividerStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Controller disconnected" />
                                    <TextBlock
                                        Style="{StaticResource CardSubtitleStyle}"
                                        Text="Show a Windows notification when a controller disconnects." />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Controller disconnected"
                                    IsOn="{x:Bind ViewModel.NotifyOnDisconnect, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                            <Border Margin="0,14" Style="{StaticResource DividerStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Only when padmon is in the background" />
                                    <TextBlock
                                        Style="{StaticResource CardSubtitleStyle}"
                                        Text="Stay quiet while the padmon window is open." />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Only when padmon is in the background"
                                    IsOn="{x:Bind ViewModel.NotifyOnlyWhenBackground, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                            <Border Margin="0,14" Style="{StaticResource DividerStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Native Windows notifications" />
                                    <TextBlock
                                        Style="{StaticResource CardSubtitleStyle}"
                                        Text="Show the shell's bottom-right notification instead of the in-app card. Works without administrator rights; falls back to in-app if the tray is unavailable." />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Native Windows notifications"
                                    IsOn="{x:Bind ViewModel.NativeNotifications, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                            <Border Margin="0,14" Style="{StaticResource DividerStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Test notification" />
                                    <TextBlock
                                        Style="{StaticResource CardSubtitleStyle}"
                                        Text="Trigger a notification now and see which presentation Windows allows." />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    AutomationProperties.Name="Test notification"
                                    Click="TestNotification_Click"
                                    Content="Send test" />
                            </Grid>
                            <TextBlock
                                Margin="0,10,0,0"
                                Style="{StaticResource CaptionStyle}"
                                Text="{x:Bind ViewModel.NotificationTestStatus, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="History" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Keep session history" />
                                    <TextBlock
                                        Style="{StaticResource CardSubtitleStyle}"
                                        Text="Known controllers stay in your list. Session events are pruned after this window." />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="140"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center"
                                    SelectedIndex="{x:Bind ViewModel.RetentionIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="30 days" />
                                    <ComboBoxItem Content="90 days" />
                                    <ComboBoxItem Content="1 year" />
                                    <ComboBoxItem Content="Forever" />
                                </ComboBox>
                            </Grid>
                            <Border Margin="0,14" Style="{StaticResource DividerStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Clear history" />
                                    <TextBlock
                                        Style="{StaticResource CardSubtitleStyle}"
                                        Text="Remove connection sessions, but keep the controllers you've named." />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    Click="ClearHistory_Click"
                                    Content="Clear…" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </StackPanel>

                <StackPanel
                    x:Name="RightSettings"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Spacing="26">

                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Appearance" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="Theme" />
                                <TextBlock
                                    Style="{StaticResource CardSubtitleStyle}"
                                    Text="Match Windows, or stay in light or dark mode." />
                            </StackPanel>
                            <ComboBox
                                x:Name="ThemePicker"
                                Grid.Column="1"
                                MinWidth="140"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center"
                                SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                                SelectionChanged="ThemePicker_SelectionChanged">
                                <ComboBoxItem Content="System" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                                <ComboBoxItem Content="Custom" />
                            </ComboBox>
                        </Grid>

                        <Border Margin="0,14" Style="{StaticResource DividerStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Use Windows accent colour" />
                                <TextBlock
                                    Style="{StaticResource CardSubtitleStyle}"
                                    Text="Colour toggles, links, highlights and the logo with your Windows accent colour. Overrides the theme's own highlight." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                MinWidth="0"
                                HorizontalAlignment="Right"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Use Windows accent colour"
                                IsOn="{x:Bind ViewModel.UseSystemAccent, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>

                        <StackPanel
                            x:Name="CustomColorsPanel"
                            Margin="0,16,0,0"
                            Spacing="12"
                            Visibility="{x:Bind ViewModel.IsCustomTheme, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{StaticResource DividerStyle}" />
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="Custom colours" />
                                <TextBlock
                                    Style="{StaticResource CardSubtitleStyle}"
                                    Text="Use six-digit hex values. Changes apply immediately." />
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock Style="{StaticResource BodyStyle}" Text="Background" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Main window surface" />
                                </StackPanel>
                                <TextBox
                                    x:Name="BackgroundColorBox"
                                    Grid.Column="1"
                                    MaxLength="7"
                                    PlaceholderText="#111214"
                                    TextChanged="ColorTextChanged" />
                                <Border
                                    x:Name="BackgroundPreview"
                                    Grid.Column="2"
                                    Width="22"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    CornerRadius="11" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock Style="{StaticResource BodyStyle}" Text="Foreground" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Cards and raised surfaces" />
                                </StackPanel>
                                <TextBox
                                    x:Name="ForegroundColorBox"
                                    Grid.Column="1"
                                    MaxLength="7"
                                    PlaceholderText="#1A1B1F"
                                    TextChanged="ColorTextChanged" />
                                <Border
                                    x:Name="ForegroundPreview"
                                    Grid.Column="2"
                                    Width="22"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    CornerRadius="11" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock Style="{StaticResource BodyStyle}" Text="Font colour" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Primary text colour" />
                                </StackPanel>
                                <TextBox
                                    x:Name="TextColorBox"
                                    Grid.Column="1"
                                    MaxLength="7"
                                    PlaceholderText="#ECEDEF"
                                    TextChanged="ColorTextChanged" />
                                <Border
                                    x:Name="TextPreview"
                                    Grid.Column="2"
                                    Width="22"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    CornerRadius="11" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock Style="{StaticResource BodyStyle}" Text="Highlight" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Toggles, labels, and the padmon mark" />
                                </StackPanel>
                                <TextBox
                                    x:Name="HighlightColorBox"
                                    Grid.Column="1"
                                    MaxLength="7"
                                    PlaceholderText="#7AA2F7"
                                    TextChanged="ColorTextChanged" />
                                <Border
                                    x:Name="HighlightPreview"
                                    Grid.Column="2"
                                    Width="22"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    CornerRadius="11" />
                            </Grid>
                        </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="About" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="padmon" />
                                    <TextBlock
                                        Style="{StaticResource CardSubtitleStyle}"
                                        Text="An open-source controller monitor for Windows." />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        x:Name="AboutVersionText"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CaptionStyle}"
                                        Text="Version 0.0.0" />
                                    <TextBlock
                                        x:Name="AboutSdlText"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource MonoStyle}"
                                        Text="SDL 0.0.0" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <HyperlinkButton
                                    Padding="0"
                                    Content="Source code"
                                    NavigateUri="https://github.com/driftywinds/padmon" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="padmon on GitHub" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" />
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Built with" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <HyperlinkButton
                                    Padding="0"
                                    Content="SDL3"
                                    NavigateUri="https://libsdl.org" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="Controller discovery, mapping and input" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <HyperlinkButton
                                    Padding="0"
                                    Content="SDL3-CS"
                                    NavigateUri="https://www.nuget.org/packages/SDL3-CS" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="C# bindings for SDL3" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <HyperlinkButton
                                    Padding="0"
                                    Content=".NET"
                                    NavigateUri="https://dotnet.microsoft.com" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="Runtime and SDK" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <HyperlinkButton
                                    Padding="0"
                                    Content="Windows App SDK"
                                    NavigateUri="https://github.com/microsoft/WindowsAppSDK" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="App platform" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <HyperlinkButton
                                    Padding="0"
                                    Content="WinUI 3"
                                    NavigateUri="https://learn.microsoft.com/windows/apps/winui/winui3/" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="User interface controls" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <HyperlinkButton
                                    Padding="0"
                                    Content="CommunityToolkit.Mvvm"
                                    NavigateUri="https://github.com/CommunityToolkit/dotnet" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="MVVM helpers" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <HyperlinkButton
                                    Padding="0"
                                    Content="SQLite"
                                    NavigateUri="https://sqlite.org" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="Local history storage" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <HyperlinkButton
                                    Padding="0"
                                    Content="Pillow"
                                    NavigateUri="https://python-pillow.org" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionStyle}"
                                    Text="Icon generation (build tooling)" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
