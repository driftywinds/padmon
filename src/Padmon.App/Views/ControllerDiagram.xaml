<UserControl
    x:Class="Padmon.Views.ControllerDiagram"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Viewbox Stretch="Uniform">
        <Canvas Width="880" Height="520">

            <!--  Body outline  -->
            <Path
                Data="M 148,108 L 732,108 C 830,108 872,166 872,252 C 872,350 800,446 700,446 C 624,446 566,410 512,394 C 480,384 400,384 368,394 C 314,410 256,446 180,446 C 80,446 8,350 8,252 C 8,166 50,108 148,108 Z"
                Fill="Transparent"
                Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                StrokeThickness="1.6" />

            <!--  Triggers  -->
            <Grid Canvas.Left="232" Canvas.Top="14" Width="40" Height="64">
                <Border
                    x:Name="LtTrigger"
                    Background="Transparent"
                    BorderBrush="{ThemeResource TextFillColorTertiaryBrush}"
                    BorderThickness="1.6"
                    CornerRadius="14" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="LT" />
            </Grid>
            <Grid Canvas.Left="608" Canvas.Top="14" Width="40" Height="64">
                <Border
                    x:Name="RtTrigger"
                    Background="Transparent"
                    BorderBrush="{ThemeResource TextFillColorTertiaryBrush}"
                    BorderThickness="1.6"
                    CornerRadius="14" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="RT" />
            </Grid>

            <!--  Bumpers  -->
            <Grid Canvas.Left="202" Canvas.Top="84" Width="100" Height="28">
                <Border
                    x:Name="LbBumper"
                    Background="Transparent"
                    BorderBrush="{ThemeResource TextFillColorTertiaryBrush}"
                    BorderThickness="1.6"
                    CornerRadius="14" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="LB" />
            </Grid>
            <Grid Canvas.Left="578" Canvas.Top="84" Width="100" Height="28">
                <Border
                    x:Name="RbBumper"
                    Background="Transparent"
                    BorderBrush="{ThemeResource TextFillColorTertiaryBrush}"
                    BorderThickness="1.6"
                    CornerRadius="14" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="RB" />
            </Grid>

            <!--  Guide, view, menu  -->
            <Ellipse
                x:Name="GuideButton"
                Canvas.Left="425"
                Canvas.Top="141"
                Width="30"
                Height="30"
                Fill="Transparent"
                Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                StrokeThickness="1.6" />
            <Ellipse
                x:Name="ViewButton"
                Canvas.Left="392"
                Canvas.Top="202"
                Width="28"
                Height="28"
                Fill="Transparent"
                Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                StrokeThickness="1.6" />
            <Ellipse
                x:Name="MenuButton"
                Canvas.Left="460"
                Canvas.Top="202"
                Width="28"
                Height="28"
                Fill="Transparent"
                Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                StrokeThickness="1.6" />

            <!--  D-pad cluster  -->
            <Ellipse
                x:Name="DPadUp"
                Canvas.Left="163"
                Canvas.Top="153"
                Width="66"
                Height="66"
                Fill="Transparent"
                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                StrokeThickness="1.6" />
            <Ellipse
                x:Name="DPadRight"
                Canvas.Left="199"
                Canvas.Top="189"
                Width="66"
                Height="66"
                Fill="Transparent"
                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                StrokeThickness="1.6" />
            <Ellipse
                x:Name="DPadDown"
                Canvas.Left="163"
                Canvas.Top="225"
                Width="66"
                Height="66"
                Fill="Transparent"
                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                StrokeThickness="1.6" />
            <Ellipse
                x:Name="DPadLeft"
                Canvas.Left="127"
                Canvas.Top="189"
                Width="66"
                Height="66"
                Fill="Transparent"
                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                StrokeThickness="1.6" />

            <!--  Face button cluster  -->
            <Grid Canvas.Left="651" Canvas.Top="153" Width="66" Height="66">
                <Ellipse
                    x:Name="FaceY"
                    Fill="Transparent"
                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                    StrokeThickness="1.6" />
                <TextBlock
                    x:Name="FaceYLabel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Y" />
            </Grid>
            <Grid Canvas.Left="687" Canvas.Top="189" Width="66" Height="66">
                <Ellipse
                    x:Name="FaceB"
                    Fill="Transparent"
                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                    StrokeThickness="1.6" />
                <TextBlock
                    x:Name="FaceBLabel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="B" />
            </Grid>
            <Grid Canvas.Left="651" Canvas.Top="225" Width="66" Height="66">
                <Ellipse
                    x:Name="FaceA"
                    Fill="Transparent"
                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                    StrokeThickness="1.6" />
                <TextBlock
                    x:Name="FaceALabel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="A" />
            </Grid>
            <Grid Canvas.Left="615" Canvas.Top="189" Width="66" Height="66">
                <Ellipse
                    x:Name="FaceX"
                    Fill="Transparent"
                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                    StrokeThickness="1.6" />
                <TextBlock
                    x:Name="FaceXLabel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="X" />
            </Grid>

            <!--  Left stick  -->
            <Grid Canvas.Left="300" Canvas.Top="278" Width="104" Height="104">
                <Ellipse
                    x:Name="LeftStickWell"
                    Fill="Transparent"
                    Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                    StrokeThickness="1.6" />
                <Canvas Width="104" Height="104">
                    <Line
                        x:Name="LeftStickRay"
                        Opacity="0.55"
                        Stroke="{StaticResource DiagramAccentBrush}"
                        StrokeEndLineCap="Round"
                        StrokeThickness="2"
                        StrokeStartLineCap="Round"
                        X1="52"
                        X2="52"
                        Y1="52"
                        Y2="52" />
                </Canvas>
                <Ellipse
                    x:Name="LeftStickDot"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="{StaticResource DiagramAccentBrush}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="LeftStickTransform" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <!--  Right stick  -->
            <Grid Canvas.Left="476" Canvas.Top="278" Width="104" Height="104">
                <Ellipse
                    x:Name="RightStickWell"
                    Fill="Transparent"
                    Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                    StrokeThickness="1.6" />
                <Canvas Width="104" Height="104">
                    <Line
                        x:Name="RightStickRay"
                        Opacity="0.55"
                        Stroke="{StaticResource DiagramAccentBrush}"
                        StrokeEndLineCap="Round"
                        StrokeThickness="2"
                        StrokeStartLineCap="Round"
                        X1="52"
                        X2="52"
                        Y1="52"
                        Y2="52" />
                </Canvas>
                <Ellipse
                    x:Name="RightStickDot"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="{StaticResource DiagramAccentBrush}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="RightStickTransform" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
        </Canvas>
    </Viewbox>
</UserControl>
