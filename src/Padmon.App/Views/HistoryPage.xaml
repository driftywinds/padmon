<Page
    x:Class="Padmon.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Padmon.ViewModels"
    Background="Transparent"
    NavigationCacheMode="Required">

    <ScrollViewer
        x:Name="PageScroll"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="PageRoot"
            Width="{Binding ViewportWidth, ElementName=PageScroll}"
            MinHeight="{Binding ViewportHeight, ElementName=PageScroll}"
            SizeChanged="PageRoot_SizeChanged"
            Style="{StaticResource PageRootStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="History" />
                <TextBlock
                    Style="{StaticResource PageSubtitleStyle}"
                    Text="A quiet record of the controllers that have passed through." />
            </StackPanel>

            <Grid
                x:Name="BodyGrid"
                Grid.Row="1"
                Margin="0,24,0,0"
                ColumnSpacing="0"
                RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    x:Name="KnownPanel"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Known controllers" />
                        <TextBlock
                            Style="{StaticResource CaptionStyle}"
                            Text="Use Merge to combine two identities, or the delete button to forget a controller." />
                    </StackPanel>

                    <Border
                        x:Name="KnownEmptyCard"
                        Style="{StaticResource CardBorderStyle}">
                        <StackPanel
                            MaxWidth="460"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                            <Border Style="{StaticResource EmptyStateGlyphCircleStyle}">
                                <FontIcon
                                    FontSize="36"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Glyph="&#xE81C;" />
                            </Border>
                            <TextBlock Style="{StaticResource LargeEmptyTitleStyle}" Text="No controllers yet" />
                            <TextBlock
                                Style="{StaticResource LargeEmptyBodyStyle}"
                                Text="Connect a controller and padmon will start building a local history." />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="KnownListCard"
                        Padding="0"
                        Style="{StaticResource CardBorderStyle}"
                        Visibility="Collapsed">
                        <ItemsRepeater ItemsSource="{x:Bind KnownControllers}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:KnownControllerViewModel">
                                    <Border
                                        Padding="16,14"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="42"
                                                Height="42"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="13">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Text="{x:Bind Initials}" />
                                            </Border>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0,12,0"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock
                                                        MaxLines="1"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource CardTitleStyle}"
                                                        Text="{x:Bind DisplayName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Border
                                                        Padding="8,2"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="8"
                                                        Visibility="{x:Bind IsMerged, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                            Text="{x:Bind MergedLabel}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock
                                                    MaxLines="1"
                                                    Style="{StaticResource CardSubtitleStyle}"
                                                    Text="{x:Bind HardwareName}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource CaptionStyle}"
                                                    Text="{x:Bind MetaText}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource CaptionStyle}"
                                                    Text="{x:Bind LastSeenText}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource CaptionStyle}"
                                                    Text="{x:Bind FirstSeenText}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="3"
                                                Margin="14,0,0,0"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <Button
                                                    AutomationProperties.Name="{x:Bind MergeActionText}"
                                                    Click="Merge_Click"
                                                    Content="{x:Bind MergeActionText}"
                                                    Tag="{x:Bind Record.StableKey}" />
                                                <Button
                                                    AutomationProperties.Name="Delete from history"
                                                    Click="Delete_Click"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Tag="{x:Bind Record.StableKey}"
                                                    ToolTipService.ToolTip="Delete from history">
                                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>

                <StackPanel
                    x:Name="SessionsPanel"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Recent connections" />

                    <Border
                        x:Name="SessionsEmptyCard"
                        Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="12">
                                <FontIcon
                                    FontSize="18"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE823;" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="No sessions recorded" />
                                <TextBlock
                                    Style="{StaticResource CardSubtitleStyle}"
                                    Text="Connect and disconnect a controller and the session will show up here." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="SessionsListCard"
                        Padding="0"
                        Style="{StaticResource CardBorderStyle}"
                        Visibility="Collapsed">
                        <ItemsRepeater ItemsSource="{x:Bind Sessions}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConnectionSessionViewModel">
                                    <Border
                                        Padding="16,12"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="38"
                                                Height="38"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="12">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Initials}" />
                                            </Border>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0,12,0"
                                                VerticalAlignment="Center"
                                                Spacing="1">
                                                <TextBlock
                                                    MaxLines="1"
                                                    Style="{StaticResource CardTitleStyle}"
                                                    Text="{x:Bind DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Style="{StaticResource CardSubtitleStyle}"
                                                    Text="{x:Bind WhenText}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CaptionStyle}"
                                                Text="{x:Bind DetailText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>

                <Border
                    x:Name="RetentionCard"
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Retention" />
                            <TextBlock
                                Style="{StaticResource CardSubtitleStyle}"
                                Text="Session events are pruned after the retention window. Known controllers stay in your list." />
                        </StackPanel>
                        <TextBlock
                            x:Name="RetentionText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0"
                            Style="{StaticResource CaptionStyle}"
                            Text="90 days" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
