<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Padmon</RootNamespace>
    <AssemblyName>Padmon</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationIcon>Assets\padmon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Padmon.Core\Padmon.Core.csproj" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\Padmon.Input\Padmon.Input.csproj" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <Target Name="BuildToastHelper" BeforeTargets="Build">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\Padmon.Toast\Padmon.Toast.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);Platform=$(Platform)" />
  </Target>

  <Target Name="CopyToastHelper" AfterTargets="Build">
    <ItemGroup>
      <ToastHelperFiles Include="$(MSBuildThisFileDirectory)..\Padmon.Toast\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.22621.0\win-x64\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ToastHelperFiles)" DestinationFolder="$(OutDir)toast" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyToastHelperToPublish" AfterTargets="Publish">
    <ItemGroup>
      <ToastHelperPublishFiles Include="$(MSBuildThisFileDirectory)..\Padmon.Toast\bin\$(Platform)\$(Configuration)\net10.0-windows10.0.22621.0\win-x64\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ToastHelperPublishFiles)" DestinationFolder="$(PublishDir)toast" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Content Include="Assets\padmon-tray.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
